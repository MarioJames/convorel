{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM"]
  },
  "include": ["setup.ts", "src/**/*.ts", "skills/**/*.ts", "tests/**/*.ts"]
}
