{
  "name": "convorel",
  "version": "0.1.0",
  "description": "Persistent ChatGPT browser reviews with a local read-only code MCP server",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.2",
  "bin": {
    "convorel": "src/cli.ts"
  },
  "files": [
    "setup.ts",
    "bun.lock",
    "src",
    "prompts",
    "skills",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "test:browser": "bun tests/browser.integration.ts",
    "test:package": "bun tests/package.integration.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "agent-browser": "0.34.0",
    "ignore": "7.0.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  },
  "trustedDependencies": [
    "agent-browser"
  ]
}
