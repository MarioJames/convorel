{
  "name": "convorel",
  "version": "0.1.0",
  "description": "让编码 Agent 与 ChatGPT 围绕真实代码持续协作，将独立意见带回本地实现与验证。",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.2",
  "bin": {
    "convorel": "src/cli.ts"
  },
  "files": [
    ".env.example",
    "setup.ts",
    "bun.lock",
    "src",
    "docs",
    "skills/chatgpt-review",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "test:browser": "bun tests/browser.integration.ts",
    "test:package": "bun tests/package.integration.ts",
    "dist": "bun --no-env-file scripts/build.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "agent-browser": "0.34.0",
    "ignore": "7.0.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  },
  "trustedDependencies": [
    "agent-browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarioJames/convorel.git"
  },
  "homepage": "https://github.com/MarioJames/convorel#readme",
  "bugs": {
    "url": "https://github.com/MarioJames/convorel/issues"
  },
  "keywords": [
    "chatgpt",
    "mcp",
    "cdp",
    "agent-browser",
    "code-review",
    "ai-agents"
  ]
}
