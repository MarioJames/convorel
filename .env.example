# OpenAI runtime API key with Tunnels Read + Use.
# Copy to .env in the convorel installation root; shell environment takes precedence.
CONVOREL_TUNNEL_API_KEY=

# ID from OpenAI Platform tunnel settings; --tunnel-id overrides this value.
CONVOREL_TUNNEL_ID=

# JSON array of allowed absolute or ~/ paths; defaults to init's workspace if blank.
# Configure your own directories, e.g. ["~/workspaces", "~/opensource"].
CONVOREL_MCP_ROOTS=

# Optional exact visible ChatGPT model label. Blank selects Latest + maximum Pro.
# The actual observed version is verified before each send; it is not hardcoded.
CONVOREL_MODEL=

# Optional destination for assistant-created conversations; set both or neither.
# Blank means name the conversation without moving it to a project or archiving it.
CONVOREL_PROJECT_URL=
CONVOREL_PROJECT_NAME=
